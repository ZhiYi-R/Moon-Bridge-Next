# 复制为 .env 后修改：
#   cp .env.example .env && chmod 600 .env
# .env 含两种 token，权限必须 600，且不得提交进版本库。

# 管理 API 与前端登录专用。请填入新生成的非空随机值，不能与网关 token 相同。
# 旧版升级时不能继续用原共享 token 作为管理凭据。
MOONBRIDGE_ADMIN_TOKEN=

# 模型客户端专用。旧版升级时填原共享 token，客户端无需改 key。
# 新部署请另生成非空随机值；未提供且配置无既有 token 时拒绝启动。
MOONBRIDGE_GATEWAY_TOKEN=

# 持久化于 /data 卷中；备份数据库时必须同时备份此密钥文件。
# 已有加密库迁移路径时须复制匹配密钥，不能生成新密钥代替。
MOONBRIDGE_KEY_FILE=/data/moonbridge.key

# 可选：启动时授权私网余额 origin，必须是精确 origin 的 JSON 数组。
# 不放在卡片 extra 中；云元数据地址始终禁止。
MOONBRIDGE_BALANCE_PRIVATE_ORIGINS=[]

# 容器时区。
TZ=Asia/Shanghai
